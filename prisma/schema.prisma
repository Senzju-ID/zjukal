generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Thread {
  id            String      @id @default(uuid())
  title         String
  description   String
  mediaUrl      String?
  mediaType     String?
  authorToken   String
  createdAt     DateTime    @default(now())
  commentsCount Int        @default(0)
  likesCount    Int        @default(0)
  
  comments     Comment[]
  likes        Like[]

  @@index([createdAt])
}

model Comment {
  id           Int         @id @default(autoincrement())
  threadId     String?
  thread       Thread?     @relation(fields: [threadId], references: [id], onDelete: Cascade)
  context      String      
  authorToken  String
  createdAt    DateTime    @default(now())
  likesCount   Int         @default(0)

  likes        Like[]

  @@index([threadId])
}

model Like {
  id           Int         @id @default(autoincrement())
  threadId     String?
  thread       Thread?     @relation(fields: [threadId], references: [id], onDelete: Cascade)
  commentId    Int?
  comment      Comment?    @relation(fields: [commentId], references: [id], onDelete: Cascade)
  authorToken   String

  @@unique([threadId, authorToken])
  @@unique([commentId, authorToken])
}